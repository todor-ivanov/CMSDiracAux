digraph CMSDiracAuxArchitecture {

    rankdir=TB;
    fontsize=18;
    labelloc="t";
    label="WMCore → DIRAC Interoperability Architecture";

    node [shape=box, style=rounded, fontsize=12];

    subgraph cluster_wmcore {
        label="CMS Workflow Layer (WMCore)";
        style=rounded;

        wmcore[label="WMCore\nWorkflow Management"];
        wmcget[label="wmcGet.py\nFetch + Serialize Workflow"];
        wmjson[label="WMCore.fetched.d\nWMTask.json\nWMStep.json\nWMSplitting.json"];

        wmcore -> wmcget;
        wmcget -> wmjson;
    }

    subgraph cluster_translation {
        label="Translation Layer";
        style=rounded;

        wmc2transf[label="wmc2transf.py\nBuild Translation IR"];
        ir[label="Canonical Translation IR\nProduction\nTask\nStep\nSplitting"];

        wmjson -> wmc2transf;
        wmc2transf -> ir;
    }

    subgraph cluster_dirac {
        label="DIRAC-style Materialization";
        style=rounded;

        emit[label="emit_translation_document"];
        transf[label="DIRAC.transf.d\nTransformations\nPluginInput\nJobs\nReports"];
        split[label="runLocalTransformation.py"];
        plugin[label="CMSWMCoreSplittingPlugin"];
        jobs[label="Task-specific Jobs\njobDescription.xml\njob.jdl"];

        ir -> emit;
        emit -> transf;
        transf -> split;
        split -> plugin;
        plugin -> jobs;
    }

    subgraph cluster_cwl {
        label="Workflow Export";
        style=rounded;

        cwlgen[label="transf2cwl.py\nExport CWL Workflow"];
        cwldir[label="DIRAC.cwl.d\nworkflow.cwl\ninputs\nmetadata"];

        jobs -> cwlgen;
        cwlgen -> cwldir;
    }

    subgraph cluster_data {
        label="Data Discovery";
        style=rounded;

        dataset[label="Dataset"];
        das[label="DAS Query\n(dasgoclient)"];
        files[label="LFN File Records"];

        dataset -> das;
        das -> files;
    }

    files -> ir;
}